# Allow to execute data files
allow platform_app_36 app_data_file:file execute;

# Allow to find camera hal
allow platform_app_36 hal_xiaomi_camera_hwservice:hwservice_manager find;

# Allow to call camera hidl
binder_call(platform_app_36, hal_camera_default)
binder_call(platform_app_36, vendor_hal_camerapostproc_xiaomi)

# Allow to read camera props
get_prop(platform_app_36, camera_prop)
get_prop(platform_app_36, vendor_camera_prop)
get_prop(platform_app_36, vendor_camera_sensor_prop)

allow platform_app_36 cgroup:file r_file_perms;

# Allow to read display props
get_prop(platform_app_36, vendor_display_prop)

# Allow to read audio props
get_prop(platform_app_36, vendor_audio_prop)

# Allow to access proc/stat
allow platform_app_36 proc_stat:file r_file_perms;

# Camera Post Processing
typeattribute platform_app_36 halclientdomain;
typeattribute platform_app_36 vendor_hal_camerapostproc_xiaomi_client;

allow platform_app_36 vendor_hal_camerapostproc_xiaomi_hwservice:hwservice_manager find;

allow platform_app_36 vendor_camera_data_file:dir { append map r_dir_perms write };
allow platform_app_36 vendor_camera_data_file:file { getattr open read };

allow platform_app_36 user_profile_data_file:dir r_dir_perms;
